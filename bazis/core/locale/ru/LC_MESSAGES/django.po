#: services/aggregating.py:79
msgid "Invalid aggregate"
msgstr "Недопустимый агрегат"

#: services/aggregating.py:101
msgid ""
"The aggregates of meta=aggregates: count, sum(f), avg(f), min(f), max(f), "
"count(f), separated by commas"
msgstr ""
"Агрегаты meta=aggregates через запятую: count, sum(f), avg(f), min(f), "
"max(f), count(f)"

#: services/aggregating.py:108
msgid ""
"The field that groups meta=aggregates: a choice, a boolean, a to-one "
"relation, or a date with :day, :week or :month"
msgstr ""
"Поле группировки meta=aggregates: поле выбора, логическое поле, связь с "
"одним объектом или дата с :day, :week или :month"

#: services/aggregating.py:132
#, python-brace-format
msgid "Unknown aggregate field '{field}' of {model}"
msgstr "Неизвестное поле агрегата '{field}' у {model}"

#: services/aggregating.py:152
#, python-brace-format
msgid ""
"Invalid aggregate '{term}': count, or sum, avg, min, max or count of a "
"field, such as sum(amount)"
msgstr ""
"Недопустимый агрегат '{term}': count либо sum, avg, min, max или count поля, "
"например sum(amount)"

#: services/aggregating.py:165
#, python-brace-format
msgid "The aggregate '{term}' does not apply to the field '{field}'"
msgstr "Агрегат '{term}' неприменим к полю '{field}'"

#: services/aggregating.py:185
#, python-brace-format
msgid "The date field '{field}' groups by day, week or month: {field}:month"
msgstr ""
"Поле даты '{field}' группируется по дням, неделям или месяцам: {field}:month"

#: services/aggregating.py:202
#, python-brace-format
msgid ""
"Cannot group by '{group}': group by a choice field, a boolean, a to-one "
"relation, or a date field by day, week or month"
msgstr ""
"Нельзя группировать по '{group}': группируйте по полю выбора, логическому "
"полю, связи с одним объектом или по дате по дням, неделям или месяцам"

#: services/aggregating.py:254
#, python-brace-format
msgid ""
"More than {limit} groups of '{group}': narrow the list with a filter, or "
"group by a date field by week or month"
msgstr ""
"Больше {limit} групп по '{group}': сузьте список фильтром или группируйте по "
"дате по неделям или месяцам"

